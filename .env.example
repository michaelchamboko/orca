# ORCA launcher / swarmctl ui environment variables
#
# These are read by `swarmctl ui`, `swarmctl doctor`, `swarmctl pair`,
# `swarmctl controller start`, and the launcher server.
#
# Copy this file to .env and edit the values for your local OpenCode
# server. Do not commit a real .env.

# OpenCode HTTP origin. Must be a loopback URL of the form
# http://127.0.0.1:<port>. The launcher rejects every other value.
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# HTTP Basic Auth credentials. OpenCode 1.18.3 returns 401 if these are
# missing or wrong; the launcher will then show OPENCODE_UNAVAILABLE and
# the role dropdowns will be empty.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=changeme
